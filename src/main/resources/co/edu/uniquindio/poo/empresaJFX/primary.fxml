<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.empresaJFX.viewController.PrimaryController">
    <children>
        <Label text="Menú Principal">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <!-- Botón anterior para Clientes -->
        <Button fx:id="btnClientes" onAction="#onOpenCrudCliente" text="Gestión de Clientes" />

        <!-- NUEVO BOTÓN PARA PRODUCTOS -->
        <Button fx:id="btnProductos" onAction="#onOpenCrudProducto" text="Gestión de Productos" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>